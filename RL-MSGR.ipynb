      "source": [
        "data = load_breast_cancer(as_frame=True)\n",
        "\n",
        "X = data.data.copy()\n",
        "\n",
        "# Scikit-learn codifica originalmente:\n",
        "# 0 = malignant, 1 = benign.\n",
        "# Para este ejercicio se invierte la codificación:\n",
        "# 0 = benigno, 1 = maligno.\n",
        "y = (data.target == 0).astype(int)\n",
        "\n",
        "datos = X.copy()\n",
        "datos[\"diagnostico\"] = y\n",
        "\n",
        "print(\"Dimensiones del conjunto:\", datos.shape)\n",
        "display(datos.head())\n"
      ]
