      "source": [
        "disp = ConfusionMatrixDisplay(\n",
        "    confusion_matrix=matriz,\n",
        "    display_labels=[\"Benigno\", \"Maligno\"]\n",
        ")\n",
        "disp.plot()\n",
        "plt.title(\"Matriz de confusión - Regresión Logística\")\n",
        "plt.show()\n"
