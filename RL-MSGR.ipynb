        }
      ],
      "source": [
        "y_pred = modelo.predict(X_test_scaled)\n",
        "probabilidades = modelo.predict_proba(X_test_scaled)\n",
        "\n",
        "print(\"Clases predichas:\")\n",
        "print(y_pred[:20])\n",
        "\n",
        "print(\"\\nProbabilidades:\")\n",
        "print(np.round(probabilidades[:20], 4))\n"
